<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.41.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Portfolio.Tests/**/*.cs" />
    <None Remove="Portfolio.Tests/**/*" />
    <EmbeddedResource Remove="Portfolio.Tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <Watch Remove="wwwroot/uploads/**" />
    <Watch Remove="data/**" />
    <Content Update="wwwroot/uploads/**" Watch="false" />
  </ItemGroup>

</Project>
